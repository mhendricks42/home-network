[server]
DOMAIN = git.home.foxhound.nexus
ROOT_URL = https://git.home.foxhound.nexus/
HTTP_PORT = 3000
DISABLE_SSH = true
OFFLINE_MODE = true

[database]
DB_TYPE = sqlite3
PATH = /data/forgejo/forgejo.db

[service]
DISABLE_REGISTRATION = true
REQUIRE_SIGNIN_VIEW = true

[security]
INSTALL_LOCK = true

[actions]
ENABLED = false
