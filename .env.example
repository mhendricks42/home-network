TZ=America/New_York
SERVER_IP=10.0.40.10
PI_IP=10.0.40.11
DATA_ROOT=/srv
RECORDINGS_ROOT=/mnt/recordings

# Required before starting Caddy; no registrar/provider has been selected.
HOME_DOMAIN=
ACME_EMAIL=
CADDY_DNS_MODULE=
DNS_PROVIDER=
DNS_API_TOKEN=

# Generate unique passwords; do not commit this file after filling it in.
MQTT_Z2M_PASSWORD=
MQTT_FRIGATE_PASSWORD=
Z2M_AUTH_TOKEN=

# Hardware-dependent profiles: set these before enabling radios/cameras.
ZIGBEE_DEVICE=/dev/serial/by-id/REPLACE_ZIGBEE
ZIGBEE_ADAPTER=ember
ZWAVE_DEVICE=/dev/serial/by-id/REPLACE_ZWAVE
DRI_DEVICE=/dev/dri/renderD128
RENDER_GID=REPLACE_RENDER_GROUP

# Full RTSP URLs. Percent-encode reserved characters in credentials.
FRIGATE_CAMERA_1_MAIN=
FRIGATE_CAMERA_1_SUB=
FRIGATE_CAMERA_2_MAIN=
FRIGATE_CAMERA_2_SUB=
FRIGATE_CAMERA_3_MAIN=
FRIGATE_CAMERA_3_SUB=
FRIGATE_CAMERA_4_MAIN=
FRIGATE_CAMERA_4_SUB=
FRIGATE_CAMERA_5_MAIN=
FRIGATE_CAMERA_5_SUB=
